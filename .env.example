# Paste your Google AI Studio Gemini API key below (never commit .env!)
GEMINI_API_KEY=
# Default verified from https://ai.google.dev/gemini-api/docs/models (alternatives: gemini-3.8-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-4-hydrogen
# Optional: GitHub personal access token for higher API rate limits in Champ's github_repo tool
GITHUB_TOKEN=
